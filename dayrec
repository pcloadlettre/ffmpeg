#!/bin/sh
# dayrec: record audio in the background, all day, to plain WAV files.
#
#   dayrec start             start recording in the background
#   dayrec stop              stop recording (files are finalized cleanly)
#   dayrec status            show whether it is running and where files go
#   dayrec run               record in the foreground (for systemd, launchd, cron)
#   dayrec devices           list audio input devices
#   dayrec transcribe [X]    transcribe a WAV, a day folder, or today (needs whisper-cli)
#   dayrec prune             delete day folders older than DAYREC_KEEP_DAYS
#
# Files land in one folder per day, one WAV per chunk:
#   ~/Recordings/dayrec/2026-09-25/14-00-00.wav
#
# Settings (environment variables, all optional):
#   DAYREC_DIR            output folder            (default ~/Recordings/dayrec)
#   DAYREC_SOURCE         mic | system | both      (default mic)
#                         mic: the microphone only. system: what you hear (calls, videos).
#                         both: mic on the left channel, what you hear on the right.
#   DAYREC_RATE           sample rate in Hz        (default 16000)
#   DAYREC_CHUNK          seconds per WAV file     (default 3600)
#   DAYREC_DEVICE         mic device               (default: system default mic)
#   DAYREC_SYSTEM_DEVICE  "what you hear" device   (default: monitor of the default output;
#                         on macOS set this to a virtual device such as BlackHole)
#   DAYREC_FORMAT         ffmpeg input format      (default: auto; pulse, alsa or avfoundation)
#   DAYREC_KEEP_DAYS      days kept by "prune"     (default 30)
#   DAYREC_WHISPER_MODEL  whisper.cpp model file   (default ~/.cache/whisper/ggml-base.en.bin)
#   DAYREC_LANG           transcription language   (default en)
#
# Needs only ffmpeg. 16 kHz mono 16-bit is about 115 MB per hour, 2.7 GB per day;
# "both" is stereo, so twice that.

set -u

DIR=${DAYREC_DIR:-"$HOME/Recordings/dayrec"}
SOURCE=${DAYREC_SOURCE:-mic}
RATE=${DAYREC_RATE:-16000}
CHUNK=${DAYREC_CHUNK:-3600}
KEEP_DAYS=${DAYREC_KEEP_DAYS:-30}
MODEL=${DAYREC_WHISPER_MODEL:-"$HOME/.cache/whisper/ggml-base.en.bin"}
LANG_=${DAYREC_LANG:-en}
PIDFILE="$DIR/.dayrec.pid"
LOGFILE="$DIR/.dayrec.log"

die() { echo "dayrec: $*" >&2; exit 1; }

command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg not found in PATH"

case $SOURCE in mic|system|both) ;; *) die "DAYREC_SOURCE must be mic, system or both" ;; esac

detect_input() {
    FMT=${DAYREC_FORMAT:-}
    DEV=${DAYREC_DEVICE:-}
    SYSDEV=${DAYREC_SYSTEM_DEVICE:-}
    if [ -z "$FMT" ]; then
        case $(uname -s) in
            Darwin) FMT=avfoundation ;;
            *)
                # PulseAudio, or PipeWire with its pulse shim, is the usual desktop case.
                if command -v pactl >/dev/null 2>&1 && pactl info >/dev/null 2>&1; then
                    FMT=pulse
                else
                    FMT=alsa
                fi ;;
        esac
    fi
    if [ -z "$DEV" ]; then
        case $FMT in
            avfoundation) DEV=":default" ;;
            *) DEV=default ;;
        esac
    fi
    if [ -z "$SYSDEV" ] && [ "$SOURCE" != mic ]; then
        case $FMT in
            # Follows whatever output is current, so switching to headphones just works.
            pulse) SYSDEV="@DEFAULT_MONITOR@" ;;
            avfoundation) die "set DAYREC_SYSTEM_DEVICE to a loopback device (e.g. \":BlackHole 2ch\"); macOS cannot capture output directly" ;;
            *) die "DAYREC_SOURCE=$SOURCE needs PulseAudio/PipeWire, or set DAYREC_SYSTEM_DEVICE to an ALSA loopback" ;;
        esac
    fi
}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# The date $1 seconds from now (GNU/busybox date -d @N, BSD/macOS date -r N).
date_in() {
    t=$(($(date +%s) + $1))
    date -d "@$t" +%F 2>/dev/null || date -r "$t" +%F
}

# The current default output on PulseAudio/PipeWire.
default_sink() {
    pactl info 2>/dev/null | sed -n 's/^Default Sink: //p'
}

# Runs one ffmpeg until killed. Input wiring depends on SOURCE.
run_ffmpeg() {
    out=$1
    case $SOURCE in
        mic)
            set -- -f "$FMT" -i "$DEV" -ac 1 ;;
        system)
            set -- -f "$FMT" -i "$SYSDEV" -ac 1 ;;
        both)
            # Two live inputs; each is downmixed to mono, resampled to a common clock,
            # then joined as left = mic, right = what you hear.
            set -- -f "$FMT" -i "$DEV" -f "$FMT" -i "$SYSDEV" \
                -filter_complex "[0:a]aformat=channel_layouts=mono,aresample=async=1000[m];[1:a]aformat=channel_layouts=mono,aresample=async=1000[s];[m][s]join=inputs=2:channel_layout=stereo[o]" \
                -map "[o]" ;;
    esac
    # exec: this runs in a backgrounded subshell, and the loop must be able to signal ffmpeg itself.
    exec ffmpeg -nostdin -hide_banner -loglevel error "$@" \
        -ar "$RATE" -c:a pcm_s16le \
        -f segment -segment_time "$CHUNK" -segment_atclocktime 1 \
        -reset_timestamps 1 -strftime 1 -segment_format wav "$out"
}

record_loop() {
    detect_input
    child=
    trap 'stopping=1; [ -n "$child" ] && kill -TERM "$child" 2>/dev/null' INT TERM
    stopping=0
    # PulseAudio keeps a stream on the monitor it opened, so a switch to headphones
    # would lose the other side; watch the default output and reopen when it changes.
    follow=
    if [ "$FMT" = pulse ] && [ "$SOURCE" != mic ] && [ -z "${DAYREC_SYSTEM_DEVICE:-}" ]; then
        follow=1
    fi
    case $SOURCE in
        mic) echo "$(date '+%F %T') recording mic $FMT:$DEV at ${RATE} Hz" ;;
        system) echo "$(date '+%F %T') recording system audio $FMT:$SYSDEV at ${RATE} Hz" ;;
        both) echo "$(date '+%F %T') recording mic $FMT:$DEV (L) + system $FMT:$SYSDEV (R) at ${RATE} Hz" ;;
    esac
    while [ "$stopping" -eq 0 ]; do
        mkdir -p "$DIR/$(date +%F)" || die "cannot create $DIR/$(date +%F)"
        [ -n "$follow" ] && sink=$(default_sink)
        # ffmpeg puts each file in its day folder itself, so it runs straight through midnight.
        run_ffmpeg "$DIR/%Y-%m-%d/%H-%M-%S.wav" &
        child=$!
        # Every 10 s: make sure the folder for a minute from now exists before ffmpeg needs
        # it, and check the output was not switched. This also paces retries.
        switched=
        while :; do
            mkdir -p "$DIR/$(date_in 60)"
            sleep 10 &
            wait $! 2>/dev/null
            if [ "$stopping" -eq 1 ] || ! kill -0 "$child" 2>/dev/null; then break; fi
            if [ -n "$follow" ] && [ "$(default_sink)" != "$sink" ]; then
                echo "$(date '+%F %T') output switched to $(default_sink), reopening"
                switched=1
                kill -TERM "$child"
                break
            fi
        done
        wait "$child"; rc=$?
        # wait returns early when a signal arrives; wait again so the WAV headers get written.
        wait "$child" 2>/dev/null
        child=
        [ "$stopping" -eq 1 ] && break
        # Device vanished or busy: the loop above already waited 10 s, so just retry.
        if [ "$rc" -ne 0 ] && [ -z "$switched" ]; then
            echo "$(date '+%F %T') ffmpeg exited ($rc), retrying"
        fi
    done
    echo "$(date '+%F %T') stopped"
}

# Transcribe one WAV with whisper.cpp. Stereo (SOURCE=both) files are split and each
# side transcribed on its own, then merged by time and labelled Me / Them.
transcribe_file() {
    wav=$1
    txt=${wav%.wav}.txt
    [ -s "$txt" ] && { echo "skip (done): $txt"; return 0; }
    tmp=$(mktemp -d) || die "mktemp failed"
    ch=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$wav")
    echo "transcribing $wav"
    if [ "$ch" = 2 ]; then
        ffmpeg -nostdin -v error -i "$wav" -ar 16000 \
            -filter_complex "[0:a]channelsplit=channel_layout=stereo[l][r]" \
            -map "[l]" "$tmp/me.wav" -map "[r]" "$tmp/them.wav" || die "split failed"
        for side in me them; do
            "$WHISPER" -m "$MODEL" -l "$LANG_" -f "$tmp/$side.wav" -ocsv -of "$tmp/$side" -np >/dev/null 2>&1 \
                || die "whisper-cli failed on $wav ($side)"
        done
        # CSV rows are start_ms,end_ms,"text". Tag each with a speaker, sort by start.
        {
            awk 'NR > 1 { print "Me\t" $0 }' "$tmp/me.csv"
            awk 'NR > 1 { print "Them\t" $0 }' "$tmp/them.csv"
        } | awk -F'\t' '{ split($2, f, ","); print f[1] "\t" $1 "\t" $2 }' \
          | sort -n -k1,1 \
          | awk -F'\t' '{
                ms = $1; who = $2
                sub(/^[0-9]*,[0-9]*,/, "", $3); t = $3
                gsub(/^"|"$/, "", t); gsub(/""/, "\"", t); sub(/^ +/, "", t)
                if (t == "") next
                printf "[%02d:%02d:%02d] %s: %s\n", ms/3600000, (ms/60000)%60, (ms/1000)%60, who, t
            }' >"$txt"
    else
        ffmpeg -nostdin -v error -i "$wav" -ar 16000 -ac 1 "$tmp/a.wav" || die "resample failed"
        "$WHISPER" -m "$MODEL" -l "$LANG_" -f "$tmp/a.wav" -ocsv -of "$tmp/a" -np >/dev/null 2>&1 \
            || die "whisper-cli failed on $wav"
        tail -n +2 "$tmp/a.csv" | awk -F, '{
                ms = $1; t = $0; sub(/^[0-9]*,[0-9]*,/, "", t)
                gsub(/^"|"$/, "", t); gsub(/""/, "\"", t); sub(/^ +/, "", t)
                if (t == "") next
                printf "[%02d:%02d:%02d] %s\n", ms/3600000, (ms/60000)%60, (ms/1000)%60, t
            }' >"$txt"
    fi
    rm -rf "$tmp"
    echo "wrote $txt"
}

cmd=${1:-status}
case $cmd in
    start)
        is_running && { echo "already recording (pid $(cat "$PIDFILE"))"; exit 0; }
        mkdir -p "$DIR" || die "cannot create $DIR"
        detect_input   # fail fast on a bad source/device combination
        # nice keeps it out of the way; it spends nearly all its time blocked on the mic anyway.
        nohup nice -n 10 "$0" run >>"$LOGFILE" 2>&1 </dev/null &
        echo $! >"$PIDFILE"
        sleep 1
        is_running || { rm -f "$PIDFILE"; die "failed to start, see $LOGFILE"; }
        echo "recording ($SOURCE) to $DIR (pid $(cat "$PIDFILE"))"
        ;;
    stop)
        is_running || { rm -f "$PIDFILE"; echo "not recording"; exit 0; }
        pid=$(cat "$PIDFILE")
        kill -TERM "$pid"
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
        rm -f "$PIDFILE"
        echo "stopped"
        ;;
    status)
        if is_running; then
            echo "recording (pid $(cat "$PIDFILE")) to $DIR"
            latest=$(ls -1 "$DIR/$(date +%F)" 2>/dev/null | grep '\.wav$' | tail -n 1)
            [ -n "$latest" ] && echo "current file: $DIR/$(date +%F)/$latest"
        else
            echo "not recording"
        fi
        du -sh "$DIR" 2>/dev/null | awk '{print "disk used: " $1}'
        ;;
    run)
        mkdir -p "$DIR" || die "cannot create $DIR"
        record_loop
        ;;
    devices)
        detect_input 2>/dev/null || true
        case ${FMT:-} in
            pulse)
                echo "# microphones and monitors (monitor = what plays on that output)"
                pactl list short sources ;;
            alsa) arecord -L 2>/dev/null || cat /proc/asound/pcm ;;
            avfoundation) ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 | grep -i -A20 audio ;;
            *) echo "no device listing for ${FMT:-unknown}" ;;
        esac
        ;;
    transcribe)
        WHISPER=$(command -v whisper-cli || command -v whisper-cpp || true)
        [ -n "$WHISPER" ] || die "whisper-cli not found; install whisper.cpp (brew install whisper-cpp, or build from source)"
        [ -f "$MODEL" ] || die "model not found: $MODEL (download a ggml model, or set DAYREC_WHISPER_MODEL)"
        target=${2:-"$DIR/$(date +%F)"}
        if [ -d "$target" ]; then
            for f in "$target"/*.wav; do
                [ -f "$f" ] || { echo "no WAV files in $target"; break; }
                # Skip the file currently being written.
                if is_running && [ "$f" = "$DIR/$(date +%F)/$(ls -1 "$DIR/$(date +%F)" | grep '\.wav$' | tail -n 1)" ]; then
                    echo "skip (still recording): $f"; continue
                fi
                transcribe_file "$f"
            done
        elif [ -f "$target" ]; then
            transcribe_file "$target"
        else
            die "no such file or folder: $target"
        fi
        ;;
    prune)
        [ -d "$DIR" ] || exit 0
        find "$DIR" -mindepth 1 -maxdepth 1 -type d -name '????-??-??' -mtime +"$KEEP_DAYS" \
            -exec rm -rf {} + -print
        ;;
    -h|--help|help)
        sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "unknown command: $cmd (try: dayrec help)"
        ;;
esac
